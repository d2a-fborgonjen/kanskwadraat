{{ header|raw }}

<div class="register-page bg-white h-100">
    <div class="register-page__header container mb-5">
        <h2 class="register-page__title">Deelnemer(s)</h2>
        <div class="register-page__feedback alert my-4" role="alert" aria-live="polite"></div>
    </div>

    <div class="register-page__container container">
        <div class="row">

            <form class="register-page__form col-12 col-lg-8 col-xxl-9" method="post" action="{{ form_action }}">
                <div class="form-section__progress mb-5">
                    <span class="form-section__progress-text">Stap 1 van 3</span>
                    <div class="form-section__progress-bar--wrapper bc-bg-blue-grey-light">
                        <div class="form-section__progress-bar"></div>
                    </div>
                </div>

                {{ hidden_inputs|raw }}

                <!-- This wrapper contains the form steps. e.g. participant(s) form, invoice details and form summary -->
                <div class="form-section-wrapper gform_wrapper gform-theme gform-theme--framework gform-theme--foundation ">

                    {% for section in form_sections %}
                    <div class="form-section__step{% if loop.first %} active{% endif %} gform_body" data-label="{{section.title}}">

                        {% if loop.first %}
                        <div class="register-form__participants d-flex flex-column gap-4">
                            <div class="register-form__participant d-flex flex-column" data-participant-index="1">
                                <div class="register-form__participant-header-wrapper mb-4">
                                    <h3 class="register-form__participant-header">Deelnemer 1</h3>
                                    <button type="button" class="register-form__remove_participant btn btn-no-after small" title="Deelnemer verwijderen">
                                        <i class="fa-regular fa-times"></i>
                                    </button>
                                </div>
                                <div class="register-form__participant-form d-flex flex-column">
                                    {{ section.form | raw }}
                                </div>
                            </div>
                        </div>
                        {% else %}
                         {{ section.form | raw }}
                        {% endif %}


                        <div class="register-form__actions d-flex justify-content-between my-4">
                            {% if loop.first %}
                            <button type="button" class="register-form__add_participant btn btn-secondary">Deelnemer toevoegen</button>
                            {% endif %}
                            {% if not loop.first %}
                                <button type="button" class="register-form__previous btn btn-tertiary btn-no-after"><i class="fa-regular fa-chevron-left"></i>Vorige</button>
                            {% endif %}
                            {% if not loop.last %}
                            <button type="button" class="register-form__next btn btn-tertiary">Volgende</button>
                            {% endif %}
                            {% if loop.last %}
                            <button type="button" class="register-form__check btn btn-secondary">Controleer gegevens</button>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}

                    <div class="form-section__step register-form--summary" data-label="Controleer gegevens">
                        <!-- summarize the form input -->
                        <div class="register-form__summary-details row">
                        </div>

                        <!-- payment method -->
                        {% if payment_methods | length > 1 and price > 0 %}
                            <h3 class="register-form__payment-method-title mb-4 gap-1">Betaalmethode</h3>
                            <div class="register-form__payment-method d-flex flex-column mb-3">
                                <label for="payment_method" class="register-form__payment-method--title mb-1">Kies uw betaalmethode:</label>
                                <select id="payment_method" name="debiteur[betaalwijzeId]" class="form-select mt-1 w-50" required>
                                    <option value="">-- Selecteer een betaalmethode --</option>
                                    {% for method in payment_methods %}
                                        <option value="{{ method.id }}">{{ method.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% elseif payment_methods | length == 1 %}
                            <input type="hidden" name="debiteur[betaalwijzeId]" value="{{ payment_methods[0].id }}">
                        {% endif %}


                        <div class="register-form__actions d-flex justify-content-between my-4">
                            <button type="button" class="register-form__previous btn btn-tertiary btn-no-after">&lt; Vorige</button>
                            <button type="submit" class="register-form__submit btn btn-primary">Verzenden</button>
                        </div>
                    </div>
                </div>

            </form>

            <div class="register-page__cart col-12 col-lg-4 col-xxl-3">
                <h3 class="register-page__cart--title">
                    Mijn investering
                </h3>
                <div class="register-page__cart--contents bc-bg-green-light p-4 rounded-4">
                    <div class="register-page__cart--item" data-price="{{ price }}">
                        <span>{{ training_type_title }}</span>
                        {% if training %}
                            <small>{{ training_day }} {{ training_date }} - {{ training_location }}</small>
                        {% endif %}
                        <small class="register-page__cart--quantity" data-quantity="1">
                            1 deelnemer
                        </small>
                    </div>

                    <div class="register-page__cart--total d-flex justify-content-space-between mt-4 pt-4">
                        <strong>Totale kosten</strong>
                        <strong class="register-page__cart--total-price">&euro; {{ price | number_format(2, '.', ',') }}</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{{ footer|raw }}
