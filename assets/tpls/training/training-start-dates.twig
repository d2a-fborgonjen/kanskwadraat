<section class="bc-calendar">
    <div class="accordion" id="training-start-dates">
        {% if variations|length == 0 %}
            <p>Er zijn momenteel geen startdata beschikbaar voor deze opleiding.</p>
        {% endif %}

        {% for variation in variations %}
            <div class="accordion-item mb-3">
                <div class="accordion-header" id="heading--{{ loop.index }}">

                    <div class="training-start-dates__header">
                        <div class="training-start-dates__header-left">
                            <div class="training-start-dates__header-info">
                                <i class="fa-thin fa-calendar me-2"></i>
                                {{ variation.date }}
                            </div>
                            <div class="training-start-dates__header-info">
                                <i class="fa-thin fa-euro me-2"></i>
                                {{ variation.price }}
                            </div>
                            <div class="training-start-dates__header-info">
                                <i class="fa-thin fa-location-dot me-2"></i>
                                {{ variation.city }}
                            </div>
                        </div>
                        <div class="training-start-dates__header-right">
                            <button class="accordion-button collapsed text-nowrap"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapse--{{ loop.index }}"
                                    aria-expanded="false"
                                    aria-controls="collapse--{{ loop.index }}">
                                <i class="fa-thin fa-circle-calendar me-2" aria-hidden="true"></i>
                                Toon planning
                                <i class="fa-light fa-chevron-down ms-1" aria-hidden="true"></i>
                            </button>

                            {% if variation.is_in_stock %}
                                <a href="{{ variation.link }}" class="btn btn-primary training__register">
                                    Inschrijven
                                </a>
                            {% else %}
                                <div class="btn btn-primary">Vol</div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- COLLAPSE CONTENT -->
                <div id="collapse--{{ loop.index }}" class="accordion-collapse collapse" data-bs-parent="#start-dates">
                    <div class="accordion-body">

                        <div class="training__planning">
                            <h5 class="training__planning-header">Lesdagen en planning</h5>
                            <ul class="training__planning-lessons">
                                {% for entry in variation.planning %}
                                    <li>
                                        <span style="flex-basis: 40%"
                                              class="training__planning-lessons-description">{{ entry.name }}</span>
                                            <span style="flex-basis: 20%"
                                                  class="training__planning-lessons-date">{{ entry.formatted_date }}</span>
                                            <span style="flex-basis: 20%"
                                                  class="training__planning-lessons-time">{{ entry.time }} uur</span>
                                    </li>
                                {% endfor %}
                            </ul>

                            <h5 class="header-color-blue">Locatiegegevens</h5>
                            <p class="training__planning-location-details">
                                {% if variation.location %}
                                    {{ variation.location }}<br/>
                                {% endif %}
                                {% if variation.address %}
                                    {{ variation.address }}<br/>
                                {% endif %}
                                {{ variation.zipcode }} {{ variation.city }}
                            </p>
                        </div>

                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    {% for style_url in style_urls %}
        <link rel="stylesheet" href="{{ style_url }}">
    {% endfor %}
</section>
