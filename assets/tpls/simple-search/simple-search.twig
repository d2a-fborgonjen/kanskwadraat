<div id="cv_simple_search_{{ name }}" class="cv_block_wrapper">
    <form class="simple-search-form" action="{{ search_page_url }}">
        <div class="d-flex flex-column flex-xl-row gap-4 {{ orientation == 'vertical' ? 'flex-column' : '' }}">
            <div id="search_field" class="flex-grow-1">
                <input name="search"
                       type="text"
                       class="cv_form-input"
                       placeholder="Zoek opleidingen...">
            </div>
            {% for category in categories %}
                <div id="category_field_{{ loop.index }}" class="flex-grow-1">
                    <select name="category_{{ loop.index }}"
                            id="category_{{ category.term_id }}"
                            class="cv_form-select">
                        <option value="" selected="selected" class="gf_placeholder">{{ category.name }}</option>
                        {% for child in category['child_categories'] %}
                            <option value="{{ child.term_id }}">{{ child.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endfor %}

            <button class="btn btn-primary text-nowrap flex-grow-1" data-label="Zoek in aanbod">
                Zoek in aanbod
            </button>
        </div>
    </form>
</div>