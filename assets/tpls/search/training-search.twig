<div class="coachview-search">

    <!-- Filter bar -->
    <div class="coachview-search__bar d-flex align-items-center gap-4">
        <button class="coachview-search__open-filters btn btn-filter btn-no-after">
            <i class="fa-thin fa-sliders-up"></i>
            Filter trainingen
            <span class="coachview-search__filter-count"></span>
        </button>

        <div class="coachview-search__input-wrapper d-flex my-2">
            <input type="text" class="coachview-search__input flex-grow-1" placeholder="Zoek trainingen..." aria-invalid="false">
            <button type="button" class="coachview-search__submit-btn">
                <i class="fa-thin fa-magnifying-glass"></i>
            </button>
        </div>
    </div>

    <div class="coachview-search__bar d-flex mb-4 align-items-center gap-4">
        <button class="coachview-search__reset-filters btn">
            Reset filters
        </button>
        <div class="coachview-search__spinner">
            <i class="fa-thin fa-spinner"></i>
        </div>
    </div>

    <section class="coachview-search__results"></section>

    <div class="coachview-search__more-items mt-4 justify-content-center" style="display: none;">
        <button class="btn btn-secondary coachview-search__load-more-items">
            Laad meer trainingen
        </button>
    </div>

    <!-- Filters -->
    <div class="coachview-search__filters-wrapper position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 p-4" style="display: none;">
        <aside class="coachview-search__filters rounded d-flex flex-column bc-bg-blue-grey-light bg-white h-100 col-5 col-sm-4 col-xl-3">

            <h3 class="coachview-search__filters-title d-flex justify-content-between align-items-center p-3 m-0">
                Filters
                <a class="coachview-search__close-filters" href="#close">
                    <i class="fa-thin fa-times"></i>
                </a>
            </h3>

            <div class="overflow-y-auto flex-grow-1 px-3">
                {{ category_list|raw }}
            </div>

            <div class="coachview-search__filters-bottom d-flex justify-content-center pt-2 p-3">
                <button class="btn btn-primary coachview-search__apply-filters">
                    filters toepassen
                </button>
            </div>
        </aside>
    </div>
</div>

{%  for style_url in style_urls %}
    <link rel="stylesheet" href="{{ style_url }}">
{% endfor %}
