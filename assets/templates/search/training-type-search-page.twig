{{ header|raw }}

<div class="coachview-search">
    <!-- Main Content -->
    <div class="coachview-search__content">
        <!-- Filter bar -->
        <div class="coachview-search__bar">
            <button class="coachview-search__open-filters cv-button cv-button-cta">
                Filters
            </button>

            <div class="coachview-search__bar-active_filters"></div>
        </div>

        <!-- Results Area -->
        <section class="coachview-search__results">
            <div class="coachview-search__spinner"></div>
        </section>
    </div>


    <!-- Filters -->
    <div class="coachview-search__filters-wrapper">
        <aside class="coachview-search__filters">
            <h4 class="coachview-search__filters-title">
                Filters
                <a class="coachview-search__close-filters" href="#close">
                    <img src="{{  assets_url }}img/icon_close.svg" />
                </a>
            </h4>

            <input type="text" class="coachview-search__input" placeholder="Zoek opleidingen...">


            {{ category_list|raw }}

            <div class="coachview-search__filters-bottom">
                <button class="cv-button cv-button-cta coachview-search__apply-filters">
                    filters toepassen
                </button>
            </div>
        </aside>
    </div>

</div>


{{ footer|raw }}
