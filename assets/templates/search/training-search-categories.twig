
<div id="filter-category-accordion" class="accordion">
    {% for parent in parent_categories %}
        <div class="accordion-item">
            <div class="accordion-header">
                <button class="accordion-button collapsed p-0 my-3"
                        data-bs-target="#category-{{ loop.index }}"
                        data-bs-toggle="collapse"
                        aria-expanded="false"
                        aria-controls="collapseCat{{ loop.index }}">
                    <h5 class="coachview-search__category-parent">
                        {{ parent.name }}
                    </h5>
                </button>
            </div>

            {% if parent.child_categories %}
                <div id="category-{{ loop.index }}"
                     class="accordion-collapse collapse coachview-search__category-children pb-3">
                    {% for child in parent.child_categories %}

                    <div class="coachview-search__category-checkbox form-check">
                        <input class="form-check-input" type="checkbox" value="{{ child.term_id }}" id="cat_{{ child.term_id }}">
                        <label class="form-check-label" for="cat_{{ child.term_id }}">
                            {{ child.name }}
                        </label>
                    </div>
                    {% endfor %}
                </div>
            {% endif %}
            </div>
    {% endfor %}
</div>