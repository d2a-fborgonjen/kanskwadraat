<section class="bc-calendar">
    <div class="accordion" id="accordion-agenda">
        {% for training in trainings %}
        <div class="accordion-item mb-3">
            <div class="accordion-header" id="heading--{{ loop.index }}">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse--{{ loop.index }}" aria-expanded="false" aria-controls="collapse--{{ loop.index }}">
                    <div class="accordion-button-inner">
                        <div class="row">
                            <div class="col-xl-5">
                                <div class="d-flex flex-row align-items-center">
                                    <div class="accordion-button-inner__image">
                                        <img width="200" height="133" src="{{ training.image_url ? training.image_url : 'https://studiobc.dev/kanskwadraat/wp-content/uploads/2024/12/black-female-teacher-teaching-group-of-kids-to-plant-seeds-at-preschool-.jpg'}}" class="attachment-post-thumbnail size-post-thumbnail wp-post-image" alt="Black female teacher teaching group of kids to plant seeds at preschool." decoding="async" srcset="https://studiobc.dev/kanskwadraat/wp-content/uploads/2024/12/black-female-teacher-teaching-group-of-kids-to-plant-seeds-at-preschool-.jpg 2000w, https://studiobc.dev/kanskwadraat/wp-content/uploads/2024/12/black-female-teacher-teaching-group-of-kids-to-plant-seeds-at-preschool--600x400.jpg 600w, https://studiobc.dev/kanskwadraat/wp-content/uploads/2024/12/black-female-teacher-teaching-group-of-kids-to-plant-seeds-at-preschool--300x200.jpg 300w, https://studiobc.dev/kanskwadraat/wp-content/uploads/2024/12/black-female-teacher-teaching-group-of-kids-to-plant-seeds-at-preschool--{{ loop.index }}024x682.jpg 1024w, https://studiobc.dev/kanskwadraat/wp-content/uploads/2024/12/black-female-teacher-teaching-group-of-kids-to-plant-seeds-at-preschool--768x512.jpg 768w, https://studiobc.dev/kanskwadraat/wp-content/uploads/2024/12/black-female-teacher-teaching-group-of-kids-to-plant-seeds-at-preschool--{{ loop.index }}536x1024.jpg 1536w" sizes="(max-width: 2000px) 100vw, 2000px">														</div>
                                    <div class="accordion-button-inner__training ps-3">
                                        <h3 class="mb-0">{{ training.name }}</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-7 d-flex flex-row align-items-center justify-content-end">
                                <div class="accordion-button-inner-wrapper py-3 py-xl-0 ps-xl-0 w-100 d-lg-flex flex-row align-items-center justify-content-between justify-content-xl-end">
                                    <div class="accordion-button-inner-wrapper__next d-flex flex-row align-items-center">
                                        <i class="fa-thin fa-circle-calendar me-2" aria-hidden="true"></i>
                                        Volgende startdatum: {{ training.display_date }}
                                    </div>
                                    <div class="accordion-button-inner-wrapper__show d-flex flex-row align-items-center px-lg-4">
                                        <i class="fa-thin fa-circle-calendar me-2" aria-hidden="true"></i> Toon data <i class="fa-light fa-chevron-down ms-1" aria-hidden="true"></i>
                                    </div>
                                    <div class="accordion-button-inner-wrapper__button mt-3 mt-lg-0">
                                        <a href="{{ training.product_url }}" class="btn btn-secondary">Meer info</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </button>
            </div>

            <div id="collapse--{{ loop.index }}" class="accordion-collapse collapse" data-bs-parent="#accordion">
                <div class="accordion-body">
                    <div class="row">
                        <div class="col-lg-6">
                            {% for item in training.all_start_dates %}
                                <div class="bc-calendar__item pt-2 pb-3 pb-md-2 d-block d-md-flex align-items-center justify-content-between">
                                    <div class="bc-calendar__item-content d-flex align-items-center">
                                        <i class="fa-thin fa-circle-calendar me-2" aria-hidden="true"></i> {{ item.display_date }} - {{ item.city }}														</div>
                                    <div class="bc-calendar__item-btn d-flex justify-content-md-end mt-2 mt-md-0">
                                        <a href="/aanmelden?tid={{ item.training_id }}" class="btn btn-primary small">Inschrijven</a>
                                    </div>
                                </div>

                                <!-- half way divider -->
                                {% if loop.index == (loop.length / 2)|round %}
                                    </div>
                                    <div class="col-lg-6">
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</section>